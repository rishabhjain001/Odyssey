# Odyssey environment variable example (Requirement 17.4)
#
# Copy this file to `.env` and adjust values as needed. These variables are
# optional; when unset, Odyssey falls back to the defaults documented below
# and the values in the active config file under configs/.

# Path to the active YAML configuration file.
# Default: configs/odyssey.yaml
ODYSSEY_CONFIG=configs/odyssey.yaml

# Directory where world-model checkpoints are written and loaded from.
# Default: checkpoints/
ODYSSEY_CHECKPOINT_DIR=checkpoints/

# Path to the persisted metrics file consumed by the dashboard and report.
# Default: artifacts/metrics.json
ODYSSEY_METRICS_PATH=artifacts/metrics.json

# Directory for generated artifacts (figures, the PDF writeup, exports).
# Default: artifacts/
ODYSSEY_ARTIFACT_DIR=artifacts/

# Device selection for PyTorch. Examples: cpu, cuda, cuda:0
# Default: cpu
ODYSSEY_DEVICE=cpu

# Restricts which GPUs are visible to the process (CUDA convention).
# Leave unset to use all available GPUs. Example: 0
CUDA_VISIBLE_DEVICES=

# Global random seed for reproducible runs.
# Default: 0
ODYSSEY_SEED=0
